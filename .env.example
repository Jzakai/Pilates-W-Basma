# Copy this file to .env and fill in the values.

# Public URL of the site (used in emails and payment redirects)
BASE_URL=http://localhost:3000
PORT=3000

# Password for the instructor dashboard at /admin (username: admin)
ADMIN_PASSWORD=change-me

# --- Online payments ---
# Leave the keys empty to run in DEMO mode (payments are simulated).
# Moyasar (Saudi Arabia: mada, Visa/Mastercard, Apple Pay, STC Pay) — https://moyasar.com
MOYASAR_SECRET_KEY=
# Secret token you set on the webhook in the Moyasar dashboard
MOYASAR_WEBHOOK_SECRET=
# Stripe (only for countries Stripe supports)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: force a provider (moyasar | stripe | demo)
PAYMENT_PROVIDER=

# --- Email (optional) ---
# If SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pilates w Basma <bookings@example.com>"
# Where to send "new booking" notifications for the instructor (optional)
ADMIN_NOTIFY_EMAIL=

# --- Booking rules ---
# How long (hours) a waitlisted person has to claim a freed-up spot
WAITLIST_OFFER_HOURS=12
# How long (hours) a bank transfer / STC Pay booking holds the spot before it is released
TRANSFER_HOLD_HOURS=24
# Customers can cancel online (with refund) up to this many hours before class
CANCELLATION_HOURS=12
# Refund the payment automatically when a customer cancels in time (true/false)
REFUND_ON_CANCEL=true

# Database file location
DATABASE_PATH=data/bookings.db
