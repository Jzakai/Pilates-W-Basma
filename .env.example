# Copy this file to .env and fill in the values.

# Public URL of the site (used in emails). On Render this is detected automatically.
BASE_URL=http://localhost:3000
PORT=3000

# Password for the instructor dashboard at /admin (username: admin)
ADMIN_PASSWORD=change-me

# --- Email (needed for confirmations, calendar invites, reminders and password resets) ---
# Option A (works on Render's free plan): Brevo API key from brevo.com → SMTP & API → API Keys.
# EMAIL_FROM must be a sender you verified in Brevo.
BREVO_API_KEY=
# Option B: SMTP (needs a host that allows SMTP; Render's free plan blocks it).
# If neither is set, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pilates w Basma <bookings@example.com>"
# Where to send "new booking" / "receipt to check" notifications for the instructor (optional)
ADMIN_NOTIFY_EMAIL=

# --- Booking rules (hours before the class starts) ---
# Online booking closes
BOOKING_CUTOFF_HOURS=48
# Unpaid bookings are released (pay-later deadline)
PAYMENT_DEADLINE_HOURS=24
# Reminder email for bookings that are still unpaid
PAYMENT_REMINDER_HOURS=48
# Clients can cancel online until (paid classes are returned as credit)
CANCELLATION_HOURS=12
# Time a waitlisted client has to claim a freed spot
WAITLIST_OFFER_HOURS=12

# --- Database and receipt storage (Supabase) ---
# Leave empty to use a local SQLite file and a local receipts folder (fine for development).
# Supabase → Connect → Session pooler connection string, with your database password filled in
DATABASE_URL=
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → service_role secret. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for receipts (created automatically)
SUPABASE_BUCKET=receipts

# Local fallback: SQLite database file; receipts go in a "receipts" folder next to it
DATABASE_PATH=data/bookings.db
# Maximum receipt upload size in MB
MAX_UPLOAD_MB=8
