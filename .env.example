# Copy this file to .env and fill in the values.

# Public URL of the site (used in emails). On Render this is detected automatically.
BASE_URL=http://localhost:3000
PORT=3000

# Password for the instructor dashboard at /admin (username: admin)
ADMIN_PASSWORD=change-me

# --- Email (needed for confirmations, reminders and password resets) ---
# If SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pilates w Basma <bookings@example.com>"
# Where to send "new booking" / "receipt to check" notifications for the instructor (optional)
ADMIN_NOTIFY_EMAIL=

# --- Booking rules (hours before the class starts) ---
# Online booking closes
BOOKING_CUTOFF_HOURS=48
# Unpaid bookings are released (pay-later deadline)
PAYMENT_DEADLINE_HOURS=24
# Reminder email for bookings that are still unpaid
PAYMENT_REMINDER_HOURS=48
# Clients can cancel online until (paid classes are returned as credit)
CANCELLATION_HOURS=12
# Time a waitlisted client has to claim a freed spot
WAITLIST_OFFER_HOURS=12

# --- Storage ---
# Database file; receipts are stored in a "receipts" folder next to it
DATABASE_PATH=data/bookings.db
# Maximum receipt upload size in MB
MAX_UPLOAD_MB=8
